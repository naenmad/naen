---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'naen.me | Software Engineer',
  description = 'A dark corner for software, systems, and things worth noticing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const isTouch = window.matchMedia('(hover: none)').matches;

      if (!reduceMotion.matches && !isTouch) {
        const layers = document.querySelectorAll<HTMLElement>('[data-parallax]');
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;

        const updateParallax = () => {
          const scrollY = window.scrollY;
          const viewportY = window.innerHeight * 0.5;

          layers.forEach((layer) => {
            const speed = Number(layer.dataset.parallax ?? 0);
            const scrollShift = (scrollY - viewportY) * speed;
            layer.style.setProperty('--parallax-x', `${pointerX * speed * 2}px`);
            layer.style.setProperty('--parallax-y', `${scrollShift + pointerY * speed * 2}px`);
          });
          frame = 0;
        };

        window.addEventListener('scroll', () => {
          if (!frame) frame = requestAnimationFrame(updateParallax);
        }, { passive: true });
        window.addEventListener('pointermove', (event) => {
          pointerX = (event.clientX / window.innerWidth - 0.5) * 36;
          pointerY = (event.clientY / window.innerHeight - 0.5) * 28;
          if (!frame) frame = requestAnimationFrame(updateParallax);
        }, { passive: true });
        updateParallax();
      }
    </script>
  </body>
</html>
