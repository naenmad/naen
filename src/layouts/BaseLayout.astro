---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'naen.me | Software Engineer',
  description = 'A quiet corner for software, systems, and things worth noticing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
