---
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import spaceGrotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Ahmad Zulkarnaen | Full-stack and Mobile Developer',
  description = 'Ahmad Zulkarnaen (naen) is a full-stack and mobile developer in Bogor and Karawang, Indonesia, building with Laravel, Next.js, and Flutter.',
  noindex = false,
} = Astro.props;

const base = (import.meta.env.SITE ?? 'https://naen.me').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, `${base}/`).href;
const ogImage = `${base}/og.png`;
const ogAlt = 'naen.me on a dark star field, with the line: I build software beneath open skies.';

const personId = `${base}/#person`;
const websiteId = `${base}/#website`;
const profileId = `${base}/#profile`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${base}/`,
      name: 'naen.me',
      description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Ahmad Zulkarnaen',
      alternateName: ['naen', 'naenmad'],
      url: `${base}/`,
      jobTitle: 'Full-stack and mobile developer',
      email: 'azulkarnaen@outlook.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bogor',
        addressRegion: 'West Java',
        addressCountry: 'ID',
      },
      sameAs: [
        'https://rx.cv/naenmad',
        'https://linkedin.com/in/naen',
        'https://github.com/naenmad',
      ],
      knowsAbout: [
        'Laravel',
        'Next.js',
        'Flutter',
        'TypeScript',
        'REST APIs',
        'Mobile development',
      ],
    },
    {
      '@type': 'ProfilePage',
      '@id': profileId,
      url: `${base}/`,
      name: 'Ahmad Zulkarnaen',
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Ahmad Zulkarnaen" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#0b1020" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="naen.me" />
    <meta name="apple-mobile-web-app-title" content="naen.me" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={spaceGrotesk700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="naen.me" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <title>{title}</title>
    {!noindex && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <script>
      // Sky depth rig. Each plane moves by how many viewports the page has scrolled,
      // so the drift stays consistent on any page length and the numbers stay bounded.
      // Touch gets a lite version: scroll only, 42% amplitude, plus opt-in sensor tilt.
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const touchQuery = window.matchMedia('(hover: none)');
      const skyPlanes = Array.from(document.querySelectorAll<HTMLElement>('[data-rate]'));
      const heroPlane = document.querySelector<HTMLElement>('[data-hero-drift]');
      const tiltToggle = document.querySelector<HTMLButtonElement>('[data-tilt-toggle]');
      const tiltLabel = document.querySelector<HTMLElement>('[data-tilt-label]');
      const tiltSupported = typeof window.DeviceOrientationEvent !== 'undefined';

      type SkyMode = 'off' | 'lite' | 'full';
      const skyMode = (): SkyMode => {
        if (motionQuery.matches) return 'off';
        return touchQuery.matches ? 'lite' : 'full';
      };

      let frame = 0;
      let scrollFactor = 0;
      let scrollTarget = 0;
      let pointerX = 0;
      let pointerY = 0;
      let easedX = 0;
      let easedY = 0;
      let tiltEnabled = false;
      let tiltDenied = false;
      let tiltListening = false;
      let tiltX = 0;
      let tiltY = 0;
      let easedTiltX = 0;
      let easedTiltY = 0;
      let tiltBaseBeta: number | null = null;

      const parallaxEnabled = () => skyMode() !== 'off';

      const measure = () => {
        scrollTarget = window.scrollY / Math.max(1, window.innerHeight);
      };

      const paint = () => {
        const mode = skyMode();
        const depth = mode === 'lite' ? 0.6 : 1;
        const pointerDepth = mode === 'full' ? 1 : 0;
        const tiltDepth = tiltEnabled ? 0.2 : 0;
        const limit = window.innerHeight * 0.57;
        skyPlanes.forEach((plane) => {
          const rate = Number(plane.dataset.rate ?? 0);
          if (!rate) return;
          if (mode === 'lite' && plane.dataset.touch === 'static') {
            if (plane.style.getPropertyValue('--py') !== '0px') {
              plane.style.setProperty('--px', '0px');
              plane.style.setProperty('--py', '0px');
            }
            return;
          }
          const px = easedX * rate * 0.08 * pointerDepth + easedTiltX * rate * tiltDepth;
          const raw =
            -scrollFactor * rate * depth +
            easedY * rate * 0.08 * pointerDepth +
            easedTiltY * rate * tiltDepth;
          const py = Math.min(limit, Math.max(-limit, raw));
          plane.style.setProperty('--px', `${px.toFixed(2)}px`);
          plane.style.setProperty('--py', `${py.toFixed(2)}px`);
        });
        // The hero text only drifts on desktop. On touch it is the main reading area.
        const heroShift = mode === 'full' ? -Math.min(1, scrollFactor) * 110 : 0;
        heroPlane?.style.setProperty('--py', `${heroShift.toFixed(2)}px`);
      };

      const tick = () => {
        frame = 0;
        if (!parallaxEnabled()) return;
        scrollFactor += (scrollTarget - scrollFactor) * 0.14;
        easedX += (pointerX - easedX) * 0.06;
        easedY += (pointerY - easedY) * 0.06;
        easedTiltX += (tiltX - easedTiltX) * 0.08;
        easedTiltY += (tiltY - easedTiltY) * 0.08;
        paint();
        const settling =
          Math.abs(scrollTarget - scrollFactor) > 0.0002 ||
          Math.abs(pointerX - easedX) > 0.001 ||
          Math.abs(pointerY - easedY) > 0.001 ||
          Math.abs(tiltX - easedTiltX) > 0.001 ||
          Math.abs(tiltY - easedTiltY) > 0.001;
        if (settling) frame = requestAnimationFrame(tick);
      };

      const requestFrame = () => {
        if (!frame && parallaxEnabled()) frame = requestAnimationFrame(tick);
      };

      const reset = () => {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        scrollFactor = 0;
        scrollTarget = 0;
        pointerX = 0;
        pointerY = 0;
        easedX = 0;
        easedY = 0;
        tiltX = 0;
        tiltY = 0;
        easedTiltX = 0;
        easedTiltY = 0;
        skyPlanes.forEach((plane) => {
          plane.style.setProperty('--px', '0px');
          plane.style.setProperty('--py', '0px');
        });
        heroPlane?.style.setProperty('--py', '0px');
      };

      const onDeviceOrientation = (event: DeviceOrientationEvent) => {
        if (!tiltEnabled || !parallaxEnabled()) return;
        const { beta, gamma } = event;
        if (beta === null || gamma === null) return;
        if (tiltBaseBeta === null) tiltBaseBeta = beta;
        // Rotate the reading axes with the screen, so landscape still tilts the right way.
        const angle = ((screen.orientation?.angle ?? 0) * Math.PI) / 180;
        const delta = beta - tiltBaseBeta;
        const x = gamma * Math.cos(angle) - delta * Math.sin(angle);
        const y = gamma * Math.sin(angle) + delta * Math.cos(angle);
        const normalise = (value: number) => Math.max(-1, Math.min(1, value / 28));
        tiltX = normalise(x);
        tiltY = normalise(y);
        requestFrame();
      };

      const attachTilt = () => {
        if (tiltListening || !tiltEnabled) return;
        window.addEventListener('deviceorientation', onDeviceOrientation, { passive: true });
        tiltListening = true;
      };

      const detachTilt = () => {
        if (!tiltListening) return;
        window.removeEventListener('deviceorientation', onDeviceOrientation);
        tiltListening = false;
      };

      const disableTilt = () => {
        tiltEnabled = false;
        detachTilt();
        tiltX = 0;
        tiltY = 0;
        tiltBaseBeta = null;
        tiltToggle?.setAttribute('aria-pressed', 'false');
        if (tiltLabel) tiltLabel.textContent = 'Tilt';
        requestFrame();
      };

      const enableTilt = () => {
        tiltEnabled = true;
        tiltBaseBeta = null;
        attachTilt();
        tiltToggle?.setAttribute('aria-pressed', 'true');
        if (tiltLabel) tiltLabel.textContent = 'Tilt on';
        requestFrame();
      };

      const denyTilt = () => {
        tiltDenied = true;
        disableTilt();
        if (tiltToggle) tiltToggle.hidden = true;
      };

      const syncTiltControl = () => {
        const available = tiltSupported && touchQuery.matches && !motionQuery.matches && !tiltDenied;
        if (!available && tiltEnabled) disableTilt();
        if (tiltToggle) tiltToggle.hidden = !available;
      };

      const sync = () => {
        syncTiltControl();
        if (!parallaxEnabled()) {
          reset();
          return;
        }
        measure();
        requestFrame();
      };

      window.addEventListener('scroll', () => {
        if (!parallaxEnabled()) return;
        measure();
        requestFrame();
      }, { passive: true });

      window.addEventListener('pointermove', (event) => {
        if (skyMode() !== 'full') return;
        pointerX = (event.clientX / window.innerWidth - 0.5) * 2;
        pointerY = (event.clientY / window.innerHeight - 0.5) * 2;
        requestFrame();
      }, { passive: true });

      tiltToggle?.addEventListener('click', async () => {
        if (tiltEnabled) {
          disableTilt();
          return;
        }
        const api = window.DeviceOrientationEvent as unknown as {
          requestPermission?: () => Promise<string>;
        };
        if (typeof api?.requestPermission === 'function') {
          try {
            const result = await api.requestPermission();
            if (result !== 'granted') {
              denyTilt();
              return;
            }
          } catch {
            denyTilt();
            return;
          }
        }
        enableTilt();
      });

      window.addEventListener('resize', sync, { passive: true });
      window.addEventListener('blur', () => {
        pointerX = 0;
        pointerY = 0;
        requestFrame();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          detachTilt();
          return;
        }
        sync();
        attachTilt();
      });

      motionQuery.addEventListener('change', sync);
      touchQuery.addEventListener('change', sync);

      sync();
    </script>

    <script>
      import { initInteractionFX } from '../scripts/interaction-fx';

      initInteractionFX();
    </script>

    <script>
      import { initCelestialDrift } from '../scripts/celestial-drift';

      initCelestialDrift();
    </script>

    <script>
      import { initSkyWishes } from '../scripts/sky-wish';
      import { initMeteorWatch } from '../scripts/meteor-watch';

      initSkyWishes();
      initMeteorWatch();
    </script>

    <script>
      // Dawn arrives with the last scroll: the arc stays dark until the page is nearly over.
      const dawn = document.querySelector<HTMLElement>('[data-dawn]');
      if (dawn) {
        const paintDawn = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const progress = max > 0 ? window.scrollY / max : 0;
          const value = Math.max(0, Math.min(1, (progress - 0.38) / 0.62));
          dawn.style.setProperty('--dawn', value.toFixed(3));
        };

        window.addEventListener('scroll', paintDawn, { passive: true });
        window.addEventListener('resize', paintDawn, { passive: true });
        paintDawn();
      }
    </script>
  </body>
</html>
