---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import CosmicScene from '../components/CosmicScene.astro';
import { illuminatedFraction, moonAge, moonLitPath } from '../scripts/lunar';

// The first paint carries the moon of the build day. A small client script corrects it
// for the visitor, so the shape is never a generic crescent.
const moonAgeNow = moonAge(new Date());
const moonPath = moonLitPath(moonAgeNow);
const moonLit = illuminatedFraction(moonAgeNow) >= 0.01;
---

<BaseLayout
  title="Ahmad Zulkarnaen | Full-stack and Mobile Developer"
  description="Ahmad Zulkarnaen (naen) is a full-stack and mobile developer in Bogor and Karawang, Indonesia, building with Laravel, Next.js, and Flutter."
>
  <!-- Fixed chrome lives outside the sky wrapper, so it always paints above the page surface. -->
  <SiteHeader />

  <div class="night-sky min-h-screen overflow-x-clip">
    <CosmicScene />

    <main id="content">
      <!-- 00: Opening -->
      <section id="top" class="section section--hero is-section-active was-active" aria-labelledby="intro-title">
        <div class="section-content">
          <div class="hero-grid">
            <div class="foreground-parallax" data-hero-drift>
              <p class="intro-meta-line">
                <span class="intro-meta-line__star" aria-hidden="true">✦</span>
                <span class="intro-meta-line__name">Ahmad Zulkarnaen</span>
                <span class="intro-meta-line__sep" aria-hidden="true">/</span>
                <span class="intro-meta-line__role">Full-stack and mobile developer</span>
              </p>

              <p class="observatory">
                <span>Bogor</span>
                <span class="observatory__sep" aria-hidden="true">·</span>
                <span data-observatory-time>--:-- WIB</span>
                <span class="observatory__sep" aria-hidden="true">·</span>
                <span data-observatory-moon>Night sky</span>
              </p>

              <h1 id="intro-title" class="intro-title">
                I build software<br />
                beneath open skies.
              </h1>

              <p class="intro-lead">
                Laravel on the server, Next.js on the web, Flutter in your pocket. I care about systems that stay readable and reliable long after release.
              </p>

              <div class="hero-actions">
                <a class="action-primary" href="https://rx.cv/naenmad" target="_blank" rel="noreferrer">Read the CV</a>
                <a class="action-secondary" href="#elsewhere">Get in touch</a>
                <a class="action-quiet" href="https://github.com/naenmad" target="_blank" rel="noreferrer">
                  GitHub
                  <ArrowIcon />
                </a>
              </div>
            </div>

            <aside class="hero-note" aria-label="A small visual note">
              <svg class="constellation-mark" viewBox="0 0 96 40" aria-hidden="true" focusable="false">
                <line x1="9" y1="31" x2="45" y2="19" />
                <line x1="45" y1="19" x2="86" y2="9" />
                <circle class="constellation-star" cx="9" cy="31" r="2.2" />
                <circle class="constellation-star constellation-star--mid" cx="45" cy="19" r="1.4" />
                <circle class="constellation-star constellation-star--far" cx="86" cy="9" r="1" />
              </svg>
              <div class="cat-image-layer section-cat-flyer section-cat-flyer--hero section-cat-flyer--right" data-side="right" aria-hidden="true">
                <div class="cat-float-wrap">
                  <div class="cat-float-inner">
                    <picture>
                      <source srcset="/cats/cat-1.webp" type="image/webp" />
                      <img class="cat-image" src="/cats/cat-1.svg" alt="Minimal white silhouette of a flying cat gliding under the stars" width="1553" height="1362" decoding="async" />
                    </picture>
                  </div>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- 01: About -->
      <section id="about" class="section" aria-labelledby="about-title">
        <div class="section-cat-flyer section-cat-flyer--left section-cat-flyer--about" data-side="left" aria-hidden="true">
          <div class="cat-float-wrap">
            <div class="cat-float-inner">
              <picture>
                <source srcset="/cats/cat-2.webp" type="image/webp" />
                <img class="section-cat-img" src="/cats/cat-2.svg" alt="" width="1499" height="1237" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>

        <svg class="about-moon" viewBox="0 0 400 400" data-drift="70" data-scale="0.08" data-rotate="2" data-pointer="10" data-moon-phase aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="about-moon-lit" cx="42%" cy="38%" r="70%">
              <stop offset="0" stop-color="rgba(238,242,246,0.22)" />
              <stop offset="0.68" stop-color="rgba(238,242,246,0.1)" />
              <stop offset="1" stop-color="rgba(238,242,246,0.04)" />
            </radialGradient>
          </defs>
          <!-- Bogor sits south of the equator, so the lit side is mirrored. -->
          <g transform="rotate(180 200 200)">
            <circle class="about-moon__disc" cx="200" cy="200" r="150" />
            <path class="about-moon__lit" data-moon-lit d={moonPath} style={`opacity:${moonLit ? '1' : '0'}`} />
          </g>
        </svg>

        <div class="section-content">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">01</span> About</p>
            <h2 id="about-title" class="section-title">Curious about how complex systems hold together.</h2>
          </div>

          <div class="section-body section-body--narrow">
            <div class="prose-night">
              <p>
                I am Ahmad Zulkarnaen, a full-stack and mobile developer working between Bogor and Karawang, Indonesia. Most of what I build is end to end: a Laravel or REST backend, a Next.js interface, a Flutter app in someone's pocket.
              </p>
              <p>
                Away from the editor I spend a lot of time outside after dark, and the rest with whichever cat has found the warmest chair. This page is the quiet side of my work. The history, the projects, and the code live in Elsewhere.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 02: Principles -->
      <section id="principles" class="section" aria-labelledby="principles-title">
        <svg class="celestial celestial--planet" viewBox="0 0 120 80" data-drift="110" data-scale="0.12" data-rotate="5" data-pointer="18" aria-hidden="true" focusable="false">
          <ellipse cx="60" cy="40" rx="50" ry="11" transform="rotate(-18 60 40)" fill="none" stroke="currentColor" stroke-opacity="0.22" />
          <circle cx="60" cy="40" r="25" fill="rgba(184,198,217,0.03)" stroke="currentColor" stroke-opacity="0.28" />
        </svg>

        <div class="section-cat-flyer section-cat-flyer--right section-cat-flyer--principles" data-side="right" aria-hidden="true">
          <div class="cat-float-wrap">
            <div class="cat-float-inner">
              <picture>
                <source srcset="/cats/cat-4.webp" type="image/webp" />
                <img class="section-cat-img" src="/cats/cat-4.svg" alt="" width="1389" height="1411" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>

        <div class="section-content">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">02</span> Principles</p>
            <h2 id="principles-title" class="section-title">How I try to work.</h2>
          </div>

          <div class="section-body">
            <ol class="principle-list">
              <li class="principle">
                <span class="principle__index" aria-hidden="true">01</span>
                <div class="principle__body">
                  <h3 class="principle__title">Readable over clever.</h3>
                  <p class="principle__text">If a line needs a comment to explain why it is smart, it is usually the wrong line. I write for the person who opens the file next, who is often me in six months.</p>
                </div>
              </li>
              <li class="principle">
                <span class="principle__index" aria-hidden="true">02</span>
                <div class="principle__body">
                  <h3 class="principle__title">Keep the boring parts boring.</h3>
                  <p class="principle__text">Auth, migrations, and deploys should be predictable. The interesting effort belongs in the product, not in a homemade way to do what the framework already does well.</p>
                </div>
              </li>
              <li class="principle">
                <span class="principle__index" aria-hidden="true">03</span>
                <div class="principle__body">
                  <h3 class="principle__title">Watch it after release.</h3>
                  <p class="principle__text">The launch is a moment. The ordinary Tuesday is the test. I care about logs, empty states, and the small edges that only appear once people use the thing.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- 03: Notes -->
      <section id="notes" class="section" aria-labelledby="notes-title">
        <svg class="celestial celestial--planet-small" viewBox="0 0 64 64" data-drift="150" data-scale="0.16" data-rotate="-8" data-pointer="26" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="planet-small-fill" cx="35%" cy="30%" r="70%">
              <stop offset="0" stop-color="rgba(238,242,246,0.18)" />
              <stop offset="0.6" stop-color="rgba(73,108,167,0.10)" />
              <stop offset="1" stop-color="rgba(11,16,32,0.05)" />
            </radialGradient>
          </defs>
          <circle cx="32" cy="32" r="17" fill="url(#planet-small-fill)" stroke="rgb(184,198,217)" stroke-opacity="0.28" stroke-width="1" />
        </svg>

        <div class="section-cat-flyer section-cat-flyer--left section-cat-flyer--notes" data-side="left" aria-hidden="true">
          <div class="cat-float-wrap">
            <div class="cat-float-inner">
              <picture>
                <source srcset="/cats/cat-5.webp" type="image/webp" />
                <img class="section-cat-img" src="/cats/cat-5.svg" alt="" width="1632" height="1707" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>

        <div class="section-content">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">03</span> Notes</p>
            <h2 id="notes-title" class="section-title">A few things I keep noticing.</h2>
          </div>

          <div class="section-body">
            <div class="note-list">
              <article class="note note--lead">
                <h3 class="note__title">Quiet software</h3>
                <p class="note__text">The best compliment a system can get is that nobody talks about it. It does the ordinary thing every day, and leaves people free to think about something else.</p>
              </article>
              <article class="note">
                <h3 class="note__title">Looking up</h3>
                <p class="note__text">I keep a small telescope's worth of patience for the sky. Most nights nothing happens, and that is the point.</p>
              </article>
              <article class="note">
                <h3 class="note__title">A cat in the room</h3>
                <p class="note__text">A cat is a useful reminder that attention is a choice. It gives it to one thing at a time, and never pretends to be interested in everything.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- 04: Elsewhere -->
      <section id="elsewhere" class="section section--elsewhere" aria-labelledby="elsewhere-title">
        <div class="section-cat-flyer section-cat-flyer--right section-cat-flyer--elsewhere" data-side="right" aria-hidden="true">
          <div class="cat-float-wrap">
            <div class="cat-float-inner">
              <picture>
                <source srcset="/cats/cat-3.webp" type="image/webp" />
                <img class="section-cat-img" src="/cats/cat-3.svg" alt="" width="1382" height="1348" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>

        <div class="section-content section-content--elsewhere">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">04</span> Elsewhere</p>
            <h2 id="elsewhere-title" class="section-title">The rest lives elsewhere.</h2>
          </div>

          <div class="section-body">
            <p class="elsewhere-lead">
              The full history, the selected projects, and the code are easier to read where they already are. This page stays small on purpose.
            </p>

            <ul class="elsewhere-list" aria-label="CV, profiles, and contact">
              <li>
                <a class="elsewhere-link" href="https://rx.cv/naenmad" target="_blank" rel="noreferrer">
                  <span class="elsewhere-label">CV</span>
                  <span class="elsewhere-value">rx.cv/naenmad</span>
                  <ArrowIcon class="elsewhere-arrow" />
                </a>
              </li>
              <li>
                <a class="elsewhere-link" href="https://linkedin.com/in/naen" target="_blank" rel="noreferrer">
                  <span class="elsewhere-label">LinkedIn</span>
                  <span class="elsewhere-value">linkedin.com/in/naen</span>
                  <ArrowIcon class="elsewhere-arrow" />
                </a>
              </li>
              <li>
                <a class="elsewhere-link" href="https://github.com/naenmad" target="_blank" rel="noreferrer">
                  <span class="elsewhere-label">GitHub</span>
                  <span class="elsewhere-value">github.com/naenmad</span>
                  <ArrowIcon class="elsewhere-arrow" />
                </a>
              </li>
              <li>
                <a class="elsewhere-link" href="mailto:azulkarnaen@outlook.com">
                  <span class="elsewhere-label">Email</span>
                  <span class="elsewhere-value">azulkarnaen@outlook.com</span>
                </a>
              </li>
            </ul>

            <p class="elsewhere-status">
              <span class="status-indicator" aria-hidden="true"></span>
              Open to software roles and selected projects.
            </p>

            <p class="elsewhere-sky" data-sky-event hidden>
              <span class="elsewhere-sky__mark" aria-hidden="true">✦</span>
              <span data-sky-event-text></span>
            </p>
          </div>
        </div>

        <footer class="site-footer" role="contentinfo">
          <div class="site-footer__inner">
            <div class="site-footer__brand">
              <a class="wordmark wordmark--footer" href="#top">
                <span class="wordmark__star" aria-hidden="true">✦</span> naen<span class="wordmark__dot">.</span>me
              </a>
              <p class="site-footer__author">Ahmad Zulkarnaen</p>
              <p class="site-footer__bio">Full-stack and mobile developer in Bogor and Karawang, Indonesia.</p>
            </div>

            <p class="site-footer__colophon">
              Built slowly under dark skies with Astro and TypeScript. Hosted on Cloudflare Pages.
            </p>
          </div>
        </footer>
      </section>
    </main>
  </div>

  <script>
    import { initObservatory, initMoonPhase } from '../scripts/observatory';

    // Near-plane drift for the cat companions: a slow 3D tilt that parks itself
    // when the pointer rests, instead of running a frame loop forever.
    const initCatParallaxEngine = () => {
      const catMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const catTouch = window.matchMedia('(hover: none)');
      const floatWraps = Array.from(document.querySelectorAll<HTMLElement>('.cat-float-wrap'));
      if (floatWraps.length === 0) return;

      let catFrame = 0;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;

      const enabled = () => !catMotion.matches && !catTouch.matches;
      const fleeCat = document.querySelector<HTMLElement>('.section-cat-flyer--about');
      let fleeTimer = 0;

      const checkFlee = (x: number, y: number) => {
        if (!fleeCat) return;
        const section = fleeCat.closest('.section');
        if (!section?.classList.contains('is-section-active')) return;
        const rect = fleeCat.getBoundingClientRect();
        if (rect.width === 0) return;
        const dx = x - (rect.left + rect.width / 2);
        const dy = y - (rect.top + rect.height / 2);
        if (Math.hypot(dx, dy) > Math.max(rect.width * 1.1, 150)) return;
        fleeCat.classList.add('is-fleeing');
        window.clearTimeout(fleeTimer);
        fleeTimer = window.setTimeout(() => fleeCat.classList.remove('is-fleeing'), 900);
      };

      const paint = () => {
        const tx = `${(currentX * 16).toFixed(2)}px`;
        const ty = `${(currentY * 12).toFixed(2)}px`;
        const rx = `${(-currentY * 10).toFixed(2)}deg`;
        const ry = `${(currentX * 14).toFixed(2)}deg`;
        floatWraps.forEach((wrap) => {
          wrap.style.setProperty('--mouse-tx', tx);
          wrap.style.setProperty('--mouse-ty', ty);
          wrap.style.setProperty('--mouse-rx', rx);
          wrap.style.setProperty('--mouse-ry', ry);
        });
      };

      const tick = () => {
        catFrame = 0;
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        paint();
        if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
          catFrame = requestAnimationFrame(tick);
        }
      };

      const requestFrame = () => {
        if (!catFrame && enabled()) catFrame = requestAnimationFrame(tick);
      };

      window.addEventListener('pointermove', (event) => {
        if (!enabled()) return;
        const halfWidth = window.innerWidth / 2;
        const halfHeight = window.innerHeight / 2;
        targetX = Math.max(-1, Math.min(1, (event.clientX - halfWidth) / halfWidth));
        targetY = Math.max(-1, Math.min(1, (event.clientY - halfHeight) / halfHeight));
        checkFlee(event.clientX, event.clientY);
        requestFrame();
      }, { passive: true });

      const rest = () => {
        targetX = 0;
        targetY = 0;
        requestFrame();
      };

      document.documentElement.addEventListener('pointerleave', rest);
      window.addEventListener('blur', rest);
      catMotion.addEventListener('change', () => {
        if (!enabled()) rest();
      });

      requestFrame();
    };

    const boot = () => {
      initCatParallaxEngine();
      initObservatory();
      initMoonPhase();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  </script>
</BaseLayout>
