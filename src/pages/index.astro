        </div>

        <div class="section-content section-content--elsewhere">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">04</span> Elsewhere</p>
            <h2 id="elsewhere-title" class="section-title">The rest lives elsewhere.</h2>
          </div>

          <div class="section-body">
