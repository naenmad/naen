              Built slowly under dark skies with Astro and TypeScript. Hosted on Cloudflare Pages.
            </p>
          </div>
        </footer>
      </section>
    </main>
  </div>

  <script>
    // Near-plane drift for the cat companions: a slow 3D tilt that parks itself
    // when the pointer rests, instead of running a frame loop forever.
    const initCatParallaxEngine = () => {
      const catMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const catTouch = window.matchMedia('(hover: none)');
      const floatWraps = Array.from(document.querySelectorAll<HTMLElement>('.cat-float-wrap'));
      if (floatWraps.length === 0) return;

      let catFrame = 0;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;

      const enabled = () => !catMotion.matches && !catTouch.matches;
      const fleeCat = document.querySelector<HTMLElement>('.section-cat-flyer--about');
      let fleeTimer = 0;

      const checkFlee = (x: number, y: number) => {
        if (!fleeCat) return;
        const section = fleeCat.closest('.section');
        if (!section?.classList.contains('is-section-active')) return;
        const rect = fleeCat.getBoundingClientRect();
        if (rect.width === 0) return;
        const dx = x - (rect.left + rect.width / 2);
        const dy = y - (rect.top + rect.height / 2);
        if (Math.hypot(dx, dy) > Math.max(rect.width * 1.1, 150)) return;
        fleeCat.classList.add('is-fleeing');
        window.clearTimeout(fleeTimer);
        fleeTimer = window.setTimeout(() => fleeCat.classList.remove('is-fleeing'), 900);
      };

      const paint = () => {
        const tx = `${(currentX * 16).toFixed(2)}px`;
        const ty = `${(currentY * 12).toFixed(2)}px`;
        const rx = `${(-currentY * 10).toFixed(2)}deg`;
        const ry = `${(currentX * 14).toFixed(2)}deg`;
        floatWraps.forEach((wrap) => {
          wrap.style.setProperty('--mouse-tx', tx);
          wrap.style.setProperty('--mouse-ty', ty);
          wrap.style.setProperty('--mouse-rx', rx);
          wrap.style.setProperty('--mouse-ry', ry);
        });
      };

      const tick = () => {
        catFrame = 0;
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        paint();
        if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
          catFrame = requestAnimationFrame(tick);
        }
      };

      const requestFrame = () => {
        if (!catFrame && enabled()) catFrame = requestAnimationFrame(tick);
      };

      window.addEventListener('pointermove', (event) => {
        if (!enabled()) return;
        const halfWidth = window.innerWidth / 2;
        const halfHeight = window.innerHeight / 2;
        targetX = Math.max(-1, Math.min(1, (event.clientX - halfWidth) / halfWidth));
        targetY = Math.max(-1, Math.min(1, (event.clientY - halfHeight) / halfHeight));
        checkFlee(event.clientX, event.clientY);
        requestFrame();
      }, { passive: true });

      const rest = () => {
        targetX = 0;
        targetY = 0;
        requestFrame();
      };

      document.documentElement.addEventListener('pointerleave', rest);
      window.addEventListener('blur', rest);
      catMotion.addEventListener('change', () => {
        if (!enabled()) rest();
      });

      requestFrame();
    };

    // A click in the sky sends one wish across it. Tapping to scroll does not fire.
    const initSkyWishes = () => {
      const wish = document.querySelector<HTMLElement>('[data-wish]');
      if (!wish) return;
      const cats = Array.from(document.querySelectorAll<HTMLElement>('.cat-float-wrap'));
      const wishMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let wishTimer = 0;
      let catTimer = 0;

      const send = (x: number, y: number) => {
        wish.classList.remove('is-flying');
        wish.style.left = `${x}px`;
        wish.style.top = `${y}px`;
        void wish.offsetWidth;
        wish.classList.add('is-flying');

        window.clearTimeout(wishTimer);
        wishTimer = window.setTimeout(() => wish.classList.remove('is-flying'), 1200);

        cats.forEach((cat) => cat.classList.add('is-struck'));
        window.clearTimeout(catTimer);
        catTimer = window.setTimeout(() => {
          cats.forEach((cat) => cat.classList.remove('is-struck'));
        }, 700);
      };

      document.addEventListener('click', (event) => {
        if (wishMotion.matches || event.defaultPrevented) return;
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('a, button, input, textarea, select, dialog, header, nav, footer')) return;
        send(event.clientX, event.clientY);
      });
    };

    // A small live readout: the local hour in Bogor and the current moon phase.
    const initObservatory = () => {
      const timeEl = document.querySelector<HTMLElement>('[data-observatory-time]');
      const moonEl = document.querySelector<HTMLElement>('[data-observatory-moon]');
      if (!timeEl && !moonEl) return;

      const SYNODIC = 29.530588853;
      const NEW_MOON = Date.UTC(2000, 0, 6, 18, 14);
      let clock: Intl.DateTimeFormat | null = null;
      try {
        clock = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Asia/Jakarta',
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
        });
      } catch {
        clock = null;
      }

      const phaseName = (age: number) => {
        if (age < 1.85 || age >= 27.68) return 'New moon';
        if (age < 5.54) return 'Waxing crescent';
        if (age < 9.23) return 'First quarter';
        if (age < 12.91) return 'Waxing gibbous';
        if (age < 16.61) return 'Full moon';
        if (age < 20.3) return 'Waning gibbous';
        if (age < 23.99) return 'Last quarter';
        return 'Waning crescent';
      };

      const update = () => {
        const now = new Date();
        if (timeEl && clock) timeEl.textContent = `${clock.format(now)} WIB`;
        if (moonEl) {
          const days = (now.getTime() - NEW_MOON) / 86_400_000;
          const age = ((days % SYNODIC) + SYNODIC) % SYNODIC;
          moonEl.textContent = phaseName(age);
        }
      };

      update();
      window.setInterval(update, 30_000);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initCatParallaxEngine();
        initSkyWishes();
        initObservatory();
      });
    } else {
      initCatParallaxEngine();
      initSkyWishes();
      initObservatory();
    }
  </script>
</BaseLayout>
