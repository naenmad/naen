        </div>
      </section>

      <!-- 02: Elsewhere -->
      <section id="elsewhere" class="section section--elsewhere" aria-labelledby="elsewhere-title">
        <div class="section-cat-flyer section-cat-flyer--right section-cat-flyer--elsewhere" data-side="right" aria-hidden="true">
          <div class="cat-float-wrap">
            <div class="cat-float-inner">
              <picture>
                <source srcset="/cats/cat-3.webp" type="image/webp" />
                <img class="section-cat-img" src="/cats/cat-3.svg" alt="" width="1382" height="1348" loading="lazy" decoding="async" />
              </picture>
            </div>
