---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout>
  <div class="night-sky min-h-screen overflow-x-clip">
    <!-- Atmospheric Scene Background Layers -->
    <div class="cosmic-scene" aria-hidden="true">
      <div class="parallax-layer nebula-layer" data-parallax="0.015"></div>
      <div class="parallax-layer galaxy-layer" data-parallax="0.07"></div>
      <div class="dust-layer">
        <span class="particle parallax-item particle-a" data-parallax="0.06"></span>
        <span class="particle parallax-item particle-b" data-parallax="0.09"></span>
        <span class="particle parallax-item particle-c" data-parallax="0.12"></span>
        <span class="particle parallax-item particle-d" data-parallax="0.15"></span>
      </div>
      <div class="star-layer">
        <span class="star parallax-item star-01" data-parallax="0.11"></span>
        <span class="star parallax-item star-02" data-parallax="0.18"></span>
        <span class="star parallax-item star-03" data-parallax="0.27"></span>
        <span class="star parallax-item star-04" data-parallax="0.14"></span>
        <span class="star parallax-item star-05" data-parallax="0.23"></span>
        <span class="star parallax-item star-06" data-parallax="0.32"></span>
        <span class="star parallax-item star-07" data-parallax="0.16"></span>
        <span class="star parallax-item star-08" data-parallax="0.29"></span>
        <span class="star parallax-item star-09" data-parallax="0.21"></span>
        <span class="star parallax-item star-10" data-parallax="0.36"></span>
        <span class="star parallax-item star-11" data-parallax="0.13"></span>
        <span class="star parallax-item star-12" data-parallax="0.25"></span>
        <span class="star parallax-item star-13" data-parallax="0.19"></span>
        <span class="star parallax-item star-14" data-parallax="0.34"></span>
        <span class="star parallax-item star-15" data-parallax="0.09"></span>
        <span class="star parallax-item star-16" data-parallax="0.30"></span>
        <span class="star parallax-item star-17" data-parallax="0.17"></span>
        <span class="star parallax-item star-18" data-parallax="0.38"></span>
        <span class="star parallax-item star-19" data-parallax="0.12"></span>
        <span class="star parallax-item star-20" data-parallax="0.26"></span>
        <span class="star parallax-item star-21" data-parallax="0.20"></span>
        <span class="star parallax-item star-22" data-parallax="0.41"></span>
        <span class="star parallax-item star-23" data-parallax="0.15"></span>
        <span class="star parallax-item star-24" data-parallax="0.33"></span>
        <span class="passing-object parallax-item" data-parallax="0.46"></span>
      </div>
    </div>

    <!-- Header Navigation -->
    <SiteHeader />

    <main id="content">
      <!-- Section 00: Opening / Hero -->
      <section id="top" class="section section--hero" aria-labelledby="intro-title">
        <div class="hero-grid">
          <div class="foreground-parallax" data-parallax="0.018">
            <div class="intro-status">
              <span class="intro-status__dot" aria-hidden="true"></span>
              <p class="intro-meta">
                <span>Ahmad Zulkarnaen</span>
                <span aria-hidden="true" class="intro-meta__sep">/</span>
                <span>Full-stack & Mobile Developer</span>
              </p>
            </div>

            <h1 id="intro-title" class="intro-title">
              I build software<br />
              beneath open skies.
            </h1>

            <p class="intro-lead">
              Engineering web and mobile systems that balance structural clarity with responsive user experience. Laravel on the server, Next.js on the web, Flutter in your pocket. Focused on software that stays reliable and maintainable after release.
            </p>

            <div class="hero-actions">
              <a class="action-primary" href="#work">Explore projects</a>
              <a class="action-secondary" href="#experience">Review CV & experience</a>
              <a class="action-quiet" href="#contact">Get in touch</a>
            </div>
          </div>

          <aside class="hero-note" aria-label="A small visual note">
            <div class="constellation-line" aria-hidden="true">
              <span class="constellation-dot constellation-dot--bright"></span>
              <span class="constellation-hairline"></span>
              <span class="constellation-dot constellation-dot--soft"></span>
            </div>
            <div class="cat-image-layer parallax-item" data-parallax="0.24">
              <picture>
                <source srcset="/cat-flying.webp" type="image/webp" />
                <img class="cat-image" src="/cat-flying.webp" alt="Minimal silhouette artwork of a flying cat under the stars" width="1200" height="1200" decoding="async" />
              </picture>
            </div>
            <p class="hero-note__caption">Usually accompanied by a cat.</p>
          </aside>
        </div>
      </section>

      <!-- Section 01: Profile -->
      <section id="about" class="section" aria-labelledby="about-title">
        <div class="section-head">
          <p class="section-kicker"><span class="kicker-index" aria-hidden="true">01</span> Profile & CV</p>
          <h2 id="about-title" class="section-title">Curious about how complex systems hold together.</h2>
        </div>

        <div class="section-body section-body--split">
          <div class="prose-night">
            <p>
              I am Ahmad Zulkarnaen, a full-stack and mobile developer working between Bogor and Karawang, Indonesia. My engineering focus centers on building end-to-end applications: architecting scalable Laravel and REST backends, crafting responsive Next.js interfaces, and delivering smooth cross-platform Flutter experiences.
            </p>
            <p>
              Currently completing my Informatics degree at Universitas Singaperbangsa Karawang (UNSIKA) with a 3.83 GPA, alongside an international study exchange at Wuhan Vocational College of Software and Engineering in China. Experiencing different software paradigms shaped my philosophy: write code that is clean, observable, and built for people.
            </p>

            <div class="cv-highlight-box">
              <div class="cv-highlight-box__info">
                <span class="cv-highlight-box__tag">CURRICULUM VITAE</span>
                <p class="cv-highlight-box__desc">Full engineering background, professional history, and accredited coursework.</p>
              </div>
              <div class="cv-highlight-box__actions">
                <a class="action-secondary" href="#experience">Jump to Experience ↓</a>
                <a class="action-quiet" href="mailto:azulkarnaen@outlook.com?subject=CV%20Request%20-%20Ahmad%20Zulkarnaen">Request PDF via Email</a>
              </div>
            </div>
          </div>

          <dl class="fact-list" aria-label="Candidate summary">
            <div class="fact-card">
              <dt>Location</dt>
              <dd>Bogor & Karawang, Indonesia</dd>
            </div>
            <div class="fact-card">
              <dt>Core Specialization</dt>
              <dd>Full-stack Web & Flutter Mobile</dd>
            </div>
            <div class="fact-card">
              <dt>Education & Academic Standing</dt>
              <dd>S1 Informatics, UNSIKA (GPA 3.83 / 4.00)</dd>
            </div>
            <div class="fact-card">
              <dt>Languages & Proficiency</dt>
              <dd>Indonesian (Native), English (TOEIC 840)</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Section 02: Experience -->
      <section id="experience" class="section" aria-labelledby="experience-title">
        <div class="section-head">
          <p class="section-kicker"><span class="kicker-index" aria-hidden="true">02</span> Work Experience</p>
          <h2 id="experience-title" class="section-title">Where I have worked and delivered.</h2>
        </div>

        <div class="section-body">
          <div class="experience-layout">
            <div class="entry-list">
              <article class="entry-card">
                <div class="entry-meta">
                  <span class="entry-period">Nov 2025 - Apr 2026</span>
                  <span class="entry-location">Depok, Indonesia</span>
                  <span class="entry-badge">Mobile Engineering</span>
                </div>
                <div class="entry-content">
                  <h3 class="entry-role">Mobile Developer <span class="entry-company">at Vixual</span></h3>
                  <p class="entry-summary">Developed and maintained cross-platform mobile features using Flutter, with attention to responsive screens and reliable state management.</p>
                  <ul class="entry-points">
                    <li>Engineered complex Flutter client views, translating multi-step interaction flows into responsive, accessible screens.</li>
                    <li>Integrated RESTful endpoints with robust error boundary handling and client-side data persistence.</li>
                    <li>Partnered directly with UI/UX designers and backend peers in rapid sprint cycles to deliver tested release candidates.</li>
                  </ul>
                </div>
              </article>

              <article class="entry-card">
                <div class="entry-meta">
                  <span class="entry-period">Aug 2025 - Dec 2025</span>
                  <span class="entry-location">East Jakarta, Indonesia</span>
                  <span class="entry-badge">Full-stack Engineering</span>
                </div>
                <div class="entry-content">
                  <h3 class="entry-role">Full-stack Developer Intern <span class="entry-company">at Citiasia Inc.</span></h3>
                  <p class="entry-summary">Contributed to enterprise web and mobile solutions utilizing modular architectures in PHP, JavaScript, and Flutter.</p>
                  <ul class="entry-points">
                    <li>Implemented modular front-end components and responsive web views with clean separation of presentation and logic.</li>
                    <li>Architected REST APIs and integrated Firebase services for real-time notifications and synchronized data store.</li>
                    <li>Maintained collaborative Git branching workflows, automated testing integration, and CI/CD deployment pipelines.</li>
                  </ul>
                </div>
              </article>
            </div>

            <!-- Leadership & Community Roles -->
            <div class="leadership-block">
              <h3 class="leadership-block__title">Leadership & Community Impact</h3>
              <div class="leadership-grid">
                <div class="leadership-card">
                  <div class="leadership-card__header">
                    <h4 class="leadership-role">Head of Education</h4>
                    <span class="leadership-org">HIMTIKA</span>
                  </div>
                  <p class="leadership-date">Jan 2025 - Nov 2025</p>
                  <p class="leadership-desc">Designed technical study tracks, mentored junior undergraduates, and organized hands-on workshops in software development and programming foundations.</p>
                </div>

                <div class="leadership-card">
                  <div class="leadership-card__header">
                    <h4 class="leadership-role">Event Director</h4>
                    <span class="leadership-org">Pekan IT 2024</span>
                  </div>
                  <p class="leadership-date">National Technology Program</p>
                  <p class="leadership-desc">Led the end-to-end planning and execution of a national technology convention featuring 1,300+ attendees and competitive participants from 36 universities across Indonesia.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 03: Selected Work -->
      <section id="work" class="section" aria-labelledby="work-title">
        <div class="section-head">
          <p class="section-kicker"><span class="kicker-index" aria-hidden="true">03</span> Selected Work</p>
          <h2 id="work-title" class="section-title">Projects built with purpose.</h2>
        </div>

        <div class="section-body">
          <div class="project-list">
            <article class="project-card">
              <div class="project-card__header">
                <div>
                  <span class="project-card__num" aria-hidden="true">PROJECT 01</span>
                  <h3 class="project-title">SISKA Mobile</h3>
                </div>
                <span class="project-kind">Academic Platform</span>
              </div>
              <p class="project-text">
                A production-ready academic information system built to streamline university administration, course registration, and real-time student evaluation. Features offline-first data caching and structured state management. Currently serves as my undergraduate thesis research.
              </p>
              <div class="project-card__footer">
                <ul class="tag-list" aria-label="Technologies used in SISKA Mobile">
                  <li>Flutter</li>
                  <li>Dart</li>
                  <li>REST API</li>
                  <li>State Management</li>
                </ul>
                <div class="project-card__status">
                  <span class="status-indicator"></span> Thesis Project
                </div>
              </div>
            </article>

            <article class="project-card">
              <div class="project-card__header">
                <div>
                  <span class="project-card__num" aria-hidden="true">PROJECT 02</span>
                  <h3 class="project-title">Lungsurin</h3>
                </div>
                <span class="project-kind">ICT Business Platform</span>
              </div>
              <p class="project-text">
                Mobile application and service integration built for an ICT business venture. Connects emerging tech initiatives with resource management workflows. Developed client-side modules in Flutter synchronized with a custom REST API.
              </p>
              <div class="project-card__footer">
                <ul class="tag-list" aria-label="Technologies used in Lungsurin">
                  <li>Flutter</li>
                  <li>Dart</li>
                  <li>REST API</li>
                  <li>Backend Sync</li>
                </ul>
                <div class="project-card__status">
                  <span class="status-indicator"></span> Shipped Product
                </div>
              </div>
            </article>

            <article class="project-card">
              <div class="project-card__header">
                <div>
                  <span class="project-card__num" aria-hidden="true">PROJECT 03</span>
                  <h3 class="project-title">Citiasia Modular</h3>
                </div>
                <span class="project-kind">Enterprise Modules</span>
              </div>
              <p class="project-text">
                Enterprise client service integration developed during internship at Citiasia Inc. Structured with modular codebases to support both browser interfaces and handheld devices. Implemented Firebase cloud messaging and granular access control.
              </p>
              <div class="project-card__footer">
                <ul class="tag-list" aria-label="Technologies used in Citiasia Modular Services">
                  <li>PHP</li>
                  <li>JavaScript</li>
                  <li>Flutter</li>
                  <li>Firebase</li>
                </ul>
                <div class="project-card__status">
                  <span class="status-indicator"></span> Enterprise
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- Section 04: Toolkit -->
      <section id="toolkit" class="section" aria-labelledby="toolkit-title">
        <div class="section-head">
          <p class="section-kicker"><span class="kicker-index" aria-hidden="true">04</span> Toolkit</p>
          <h2 id="toolkit-title" class="section-title">Languages, frameworks, and engineering habits.</h2>
        </div>

        <div class="section-body">
          <div class="toolkit-grid">
            <div class="toolkit-category">
              <div class="toolkit-category__head">
                <span class="toolkit-category__glyph" aria-hidden="true">01</span>
                <h3>Languages</h3>
              </div>
              <ul class="pill-list">
                <li>PHP</li>
                <li>JavaScript</li>
                <li>TypeScript</li>
                <li>Dart</li>
                <li>HTML5</li>
                <li>CSS3 & SCSS</li>
                <li>Java</li>
                <li>Kotlin</li>
                <li>SQL</li>
              </ul>
            </div>

            <div class="toolkit-category">
              <div class="toolkit-category__head">
                <span class="toolkit-category__glyph" aria-hidden="true">02</span>
                <h3>Frameworks & UI</h3>
              </div>
              <ul class="pill-list">
                <li>Laravel</li>
                <li>Next.js</li>
                <li>React</li>
                <li>Flutter</li>
                <li>Tailwind CSS</li>
                <li>Astro</li>
              </ul>
            </div>

            <div class="toolkit-category">
              <div class="toolkit-category__head">
                <span class="toolkit-category__glyph" aria-hidden="true">03</span>
                <h3>Backend & Data</h3>
              </div>
              <ul class="pill-list">
                <li>RESTful APIs</li>
                <li>Firebase</li>
                <li>MySQL</li>
                <li>PostgreSQL</li>
                <li>Node.js</li>
                <li>SSR & SSG</li>
              </ul>
            </div>

            <div class="toolkit-category">
              <div class="toolkit-category__head">
                <span class="toolkit-category__glyph" aria-hidden="true">04</span>
                <h3>Practice & Ops</h3>
              </div>
              <ul class="pill-list">
                <li>Git & GitHub</li>
                <li>CI/CD Pipelines</li>
                <li>Docker Basics</li>
                <li>Agile & Scrum</li>
                <li>Clean Architecture</li>
                <li>Testing & Review</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 05: Education & Credentials -->
      <section id="education" class="section" aria-labelledby="education-title">
        <div class="section-head">
          <p class="section-kicker"><span class="kicker-index" aria-hidden="true">05</span> Education & Credentials</p>
          <h2 id="education-title" class="section-title">Academic path and industry certifications.</h2>
        </div>

        <div class="section-body education-layout">
          <div class="education-column">
            <article class="edu-card">
              <div class="edu-card__header">
                <span class="edu-card__period">Aug 2023 - Present</span>
                <span class="edu-card__location">Karawang, Indonesia</span>
              </div>
              <h3 class="edu-card__title">S1 Informatics</h3>
              <p class="edu-card__institution">Singaperbangsa Karawang University (UNSIKA)</p>
              <div class="edu-card__highlight">Current Cumulative GPA: 3.83 / 4.00</div>
              <p class="edu-card__note">
                Advanced studies in software engineering, database architecture, mobile application paradigms, and algorithms. Currently conducting thesis research on mobile academic management systems.
              </p>
            </article>

            <article class="edu-card">
              <div class="edu-card__header">
                <span class="edu-card__period">Mar 2026 - Jun 2026</span>
                <span class="edu-card__location">Wuhan, China</span>
              </div>
              <h3 class="edu-card__title">International Student Exchange</h3>
              <p class="edu-card__institution">Wuhan Vocational College of Software and Engineering</p>
              <div class="edu-card__highlight">Selected via Irootech & UNSIKA Academic Partnership</div>
              <p class="edu-card__note">
                Immersive academic study within China's tech ecosystem, studying applied software engineering, manufacturing technology, and cross-cultural technical methodologies.
              </p>
            </article>
          </div>

          <aside class="credentials-column">
            <div class="credentials-box">
              <h3 class="credentials-box__title">Verified Certifications</h3>
              <ul class="cert-list">
                <li class="cert-item">
                  <div class="cert-item__icon" aria-hidden="true">✦</div>
                  <div class="cert-item__info">
                    <span class="cert-name">GitHub Foundations</span>
                    <span class="cert-meta">GitHub Certified / Issued Mar 2025</span>
                  </div>
                </li>
                <li class="cert-item">
                  <div class="cert-item__icon" aria-hidden="true">✦</div>
                  <div class="cert-item__info">
                    <span class="cert-name">Junior Web Developer</span>
                    <span class="cert-meta">BNSP Indonesia / Issued Aug 2023</span>
                  </div>
                </li>
                <li class="cert-item">
                  <div class="cert-item__icon" aria-hidden="true">✦</div>
                  <div class="cert-item__info">
                    <span class="cert-name">TOEIC Official Certificate</span>
                    <span class="cert-meta">Score 840 / Professional Working Proficiency</span>
                  </div>
                </li>
              </ul>
            </div>

            <div class="credentials-status">
              <p class="credentials-status__label">Academic Inquiries</p>
              <p class="credentials-status__text">Transcripts, syllabi, or verification letters available upon formal request.</p>
            </div>
          </aside>
        </div>
      </section>

      <!-- Section 06: Contact & Finale (Slide 06) -->
      <section id="contact" class="section section--contact" aria-labelledby="contact-title">
        <div class="contact-slide-content">
          <div class="section-head">
            <p class="section-kicker"><span class="kicker-index" aria-hidden="true">06</span> Contact</p>
            <h2 id="contact-title" class="section-title">Have something worth building?</h2>
          </div>

          <div class="section-body contact-body">
            <p class="contact-lead">
              Whether you need a dedicated Flutter mobile application, an adaptable Laravel backend, or a full-stack web interface, I am open to discussing software roles and high-impact engineering projects.
            </p>

            <div class="contact-card">
              <div class="contact-card__main">
                <span class="contact-card__label">Primary Communication Channel</span>
                <a class="contact-card__email" href="mailto:azulkarnaen@outlook.com">
                  azulkarnaen@outlook.com
                </a>
                <p class="contact-card__subtext">Replies typically within 24 hours under local time (WIB / UTC+7).</p>
              </div>
              <div class="contact-card__actions">
                <a class="action-primary" href="mailto:azulkarnaen@outlook.com">Send an email</a>
              </div>
            </div>

            <div class="contact-socials">
              <span class="contact-socials__title">Professional Networks</span>
              <div class="contact-socials__links">
                <a class="social-link" href="https://linkedin.com/in/naen" target="_blank" rel="noreferrer">
                  <span>LinkedIn</span>
                  <span class="social-link__arrow" aria-hidden="true">↗</span>
                </a>
                <a class="social-link" href="https://instagram.com/madnaen" target="_blank" rel="noreferrer">
                  <span>Instagram</span>
                  <span class="social-link__arrow" aria-hidden="true">↗</span>
                </a>
                <a class="social-link" href="https://github.com" target="_blank" rel="noreferrer">
                  <span>GitHub</span>
                  <span class="social-link__arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Integrated Nocturnal Footer -->
        <footer class="site-footer" role="contentinfo">
          <div class="site-footer__inner">
            <div class="site-footer__brand">
              <a class="wordmark wordmark--footer" href="#top">
                <span class="wordmark__star" aria-hidden="true">✦</span> naen<span class="wordmark__dot">.</span>me
              </a>
              <p class="site-footer__author">Ahmad Zulkarnaen</p>
              <p class="site-footer__bio">
                Full-stack and mobile developer in Bogor & Karawang, Indonesia.
              </p>
            </div>

            <div class="site-footer__status-box">
              <div class="site-footer__status">
                <span class="status-indicator"></span>
                <span>Available for engineering roles & select projects</span>
              </div>
              <p class="site-footer__colophon">
                Built slowly under dark skies with Astro & TypeScript. Hosted on Cloudflare Pages.
              </p>
            </div>

            <div class="site-footer__actions">
              <a class="site-footer__top-btn" href="#top" aria-label="Return to top of page">
                <span>Top</span>
                <span aria-hidden="true">↑</span>
              </a>
            </div>
          </div>
        </footer>
      </section>
    </main>
  </div>
</BaseLayout>
