---
const sections = [
  { id: 'top', index: '00', label: 'Opening', note: 'Overview & introduction' },
  { id: 'about', index: '01', label: 'Profile', note: 'Background & education' },
  { id: 'experience', index: '02', label: 'Experience', note: 'Work & engineering roles' },
  { id: 'work', index: '03', label: 'Work', note: 'Selected projects' },
  { id: 'toolkit', index: '04', label: 'Toolkit', note: 'Stack & technical skills' },
  { id: 'education', index: '05', label: 'Education', note: 'Studies & credentials' },
  { id: 'contact', index: '06', label: 'Contact', note: 'Get in touch' },
];
---

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="wordmark" href="#top" aria-label="naen.me - Return to top">
      <span class="wordmark__star" aria-hidden="true">✦</span>
      naen<span class="wordmark__dot">.</span>me
    </a>

    <!-- Live Coordinate / Section Readout -->
    <div class="section-readout" aria-live="polite" aria-atomic="true">
      <span class="section-readout__prefix" aria-hidden="true">SEC</span>
      <span class="section-readout__index" data-readout-index>00</span>
      <span class="section-readout__sep" aria-hidden="true">/</span>
      <span class="section-readout__label" data-readout-label>Opening</span>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="desktop-nav__list">
        <li><a href="#about" class="desktop-nav__link" data-nav-link="about">Profile</a></li>
        <li><a href="#experience" class="desktop-nav__link" data-nav-link="experience">Experience</a></li>
        <li><a href="#work" class="desktop-nav__link" data-nav-link="work">Work</a></li>
        <li><a href="#toolkit" class="desktop-nav__link" data-nav-link="toolkit">Toolkit</a></li>
        <li><a href="#education" class="desktop-nav__link" data-nav-link="education">Education</a></li>
        <li><a href="#contact" class="desktop-nav__link desktop-nav__link--cta" data-nav-link="contact">Contact</a></li>
      </ul>
    </nav>

    <!-- Jump / Menu Toggle (Both mobile & quick desktop palette) -->
    <button
      class="index-toggle"
      type="button"
      data-index-toggle
      aria-expanded="false"
      aria-controls="section-index"
      aria-haspopup="dialog"
      aria-label="Open section navigation menu"
    >
      <span class="index-toggle__icon" aria-hidden="true">
        <span class="index-toggle__bar"></span>
        <span class="index-toggle__bar"></span>
      </span>
      <span class="index-toggle__text">Sections</span>
      <kbd class="index-toggle__kbd" aria-hidden="true">J</kbd>
    </button>
  </div>
</header>

<!-- Desktop Side Constellation Rail -->
<nav class="section-rail" aria-label="Constellation section rail">
  <div class="section-rail__track" aria-hidden="true"></div>
  <ol class="section-rail__list">
    {sections.map((section) => (
      <li class="section-rail__item">
        <a
          href={`#${section.id}`}
          class="section-rail__link"
          data-section-link={section.id}
          aria-label={`Jump to Section ${section.index}: ${section.label}`}
        >
          <span class="rail-label">{section.label}</span>
          <span class="rail-mark" aria-hidden="true"></span>
          <span class="rail-index" aria-hidden="true">{section.index}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<!-- Accessible Jump-To / Navigation Dialog -->
<dialog id="section-index" class="index-dialog" aria-labelledby="index-title">
  <div class="index-dialog__inner">
    <div class="index-dialog__bar">
      <div>
        <p class="index-dialog__eyebrow" aria-hidden="true">NAVIGATION INDEX</p>
        <h2 id="index-title" class="index-dialog__title">Jump to section</h2>
      </div>
      <button class="index-dialog__close" type="button" data-index-close aria-label="Close navigation dialog">
        <span aria-hidden="true">✕</span>
        <span>Close</span>
      </button>
    </div>

    <p class="index-dialog__hint" aria-hidden="true">
      Press <kbd>Esc</kbd> to dismiss or select a destination:
    </p>

    <ol class="index-dialog__list">
      {sections.map((section) => (
        <li>
          <a href={`#${section.id}`} class="index-dialog__link" data-index-link={section.id}>
            <span class="index-dialog__index" aria-hidden="true">{section.index}</span>
            <div class="index-dialog__meta">
              <span class="index-dialog__label">{section.label}</span>
              <span class="index-dialog__note">{section.note}</span>
            </div>
            <span class="index-dialog__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="index-dialog__footer">
      <a class="index-dialog__action" href="#top" data-index-link="top">
        <span aria-hidden="true">↑</span> Back to top
      </a>
      <a class="index-dialog__action" href="mailto:azulkarnaen@outlook.com">
        <span aria-hidden="true">✉</span> azulkarnaen@outlook.com
      </a>
    </div>
  </div>
</dialog>
<!-- Accessible Floating Scroll-To-Top Button -->
<a
  class="to-top"
  href="#top"
  data-to-top
  aria-label="Scroll back to top of page"
  title="Back to top"
>
  <svg class="to-top__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
  <span class="to-top__label">Top</span>
</a>
