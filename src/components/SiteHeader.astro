---
import ArrowIcon from './ArrowIcon.astro';

const sections = [
  { id: 'top', index: '00', label: 'Opening', note: 'Overview' },
  { id: 'about', index: '01', label: 'About', note: 'Who I am, and where' },
  { id: 'principles', index: '02', label: 'Principles', note: 'How I try to work' },
  { id: 'notes', index: '03', label: 'Notes', note: 'A few things I notice' },
  { id: 'elsewhere', index: '04', label: 'Elsewhere', note: 'CV, code, and contact' },
];
---

<!-- Desktop & Top Header -->
<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="wordmark" href="#top" aria-label="naen.me - Return to top">
      <span class="wordmark__star" aria-hidden="true">✦</span>
      naen<span class="wordmark__dot">.</span>me
    </a>

    <!-- Live Coordinate / Section Readout (Desktop) -->
    <div class="section-readout" aria-live="polite" aria-atomic="true">
      <span class="section-readout__prefix" aria-hidden="true">SEC</span>
      <span class="section-readout__index" data-readout-index>00</span>
      <span class="section-readout__sep" aria-hidden="true">/</span>
      <span class="section-readout__label" data-readout-label>Opening</span>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="desktop-nav__list">
        <li><a href="#about" class="desktop-nav__link" data-nav-link="about">About</a></li>
        <li><a href="#principles" class="desktop-nav__link" data-nav-link="principles">Principles</a></li>
        <li><a href="#notes" class="desktop-nav__link" data-nav-link="notes">Notes</a></li>
        <li><a href="#elsewhere" class="desktop-nav__link" data-nav-link="elsewhere">Elsewhere</a></li>
      </ul>
    </nav>

    <!-- Desktop Jump / Menu Toggle -->
    <button
      class="index-toggle"
      type="button"
      data-index-toggle
      aria-expanded="false"
      aria-controls="section-index"
      aria-haspopup="dialog"
      aria-label="Open section navigation menu"
    >
      <span class="index-toggle__icon" aria-hidden="true">
        <span class="index-toggle__bar"></span>
        <span class="index-toggle__bar"></span>
      </span>
      <span class="index-toggle__text">Sections</span>
      <kbd class="index-toggle__kbd" aria-hidden="true">J</kbd>
    </button>

    <!-- Mobile: motion toggle and section menu, on the wordmark row -->
    <div class="mobile-actions">
      <button class="tilt-toggle" type="button" data-tilt-toggle aria-pressed="false" hidden>
        <span class="tilt-toggle__mark" aria-hidden="true">✦</span>
        <span data-tilt-label>Tilt</span>
      </button>

      <button
        class="mobile-menu"
        type="button"
        data-index-toggle
        data-mobile-menu
        aria-expanded="false"
        aria-controls="section-index"
        aria-haspopup="dialog"
        aria-label="Open section menu"
      >
        <span class="mobile-menu__index" data-mobile-readout-index>00</span>
        <span class="mobile-menu__label">Menu</span>
        <span class="mobile-menu__bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Desktop Side Constellation Rail -->
<nav class="section-rail" aria-label="Constellation section rail">
  <div class="section-rail__track" aria-hidden="true"></div>
  <span class="section-rail__fill" aria-hidden="true"></span>
  <svg class="section-rail__star" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M8 1 L9.3 6.7 L15 8 L9.3 9.3 L8 15 L6.7 9.3 L1 8 L6.7 6.7 Z" />
  </svg>
  <ol class="section-rail__list">
    {sections.map((section) => (
      <li class="section-rail__item">
        <a
          href={`#${section.id}`}
          class="section-rail__link"
          data-section-link={section.id}
          aria-label={`Jump to Section ${section.index}: ${section.label}`}
        >
          <span class="rail-label">{section.label}</span>
          <span class="rail-mark" aria-hidden="true"></span>
          <span class="rail-index" aria-hidden="true">{section.index}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<!-- Accessible Jump-To / Navigation Dialog -->
<dialog id="section-index" class="index-dialog" aria-labelledby="index-title">
  <div class="index-dialog__inner">
    <div class="index-dialog__bar">
      <div>
        <p class="index-dialog__eyebrow" aria-hidden="true">NAVIGATION INDEX</p>
        <h2 id="index-title" class="index-dialog__title">Jump to section</h2>
      </div>
      <button class="index-dialog__close" type="button" data-index-close aria-label="Close navigation dialog">
        <span aria-hidden="true">✕</span>
        <span>Close</span>
      </button>
    </div>

    <p class="index-dialog__hint" aria-hidden="true">
      Tap any destination to navigate:
    </p>

    <ol class="index-dialog__list">
      {sections.map((section) => (
        <li>
          <a href={`#${section.id}`} class="index-dialog__link" data-index-link={section.id}>
            <span class="index-dialog__index" aria-hidden="true">{section.index}</span>
            <div class="index-dialog__meta">
              <span class="index-dialog__label">{section.label}</span>
              <span class="index-dialog__note">{section.note}</span>
            </div>
            <ArrowIcon class="index-dialog__arrow" direction="right" />
          </a>
        </li>
      ))}
    </ol>

    <div class="index-dialog__footer">
      <a class="index-dialog__action" href="#top" data-index-link="top">
        <ArrowIcon direction="up" /> Back to top
      </a>
      <a class="index-dialog__action" href="mailto:azulkarnaen@outlook.com">
        azulkarnaen@outlook.com
      </a>
    </div>
  </div>
</dialog>

<!-- Accessible Floating Scroll-To-Top Button (Desktop only) -->
<a
  class="to-top"
  href="#top"
  data-to-top
  aria-label="Scroll back to top of page"
  title="Back to top"
>
  <svg class="to-top__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
  <span class="to-top__label">Top</span>
</a>

<script>
  // Section Navigation, Observer, Dialog, and Scroll-to-top logic
  const sections = ['top', 'about', 'principles', 'notes', 'elsewhere'];
  const sectionMeta: Record<string, { index: string; label: string }> = {
    top: { index: '00', label: 'Opening' },
    about: { index: '01', label: 'About' },
    principles: { index: '02', label: 'Principles' },
    notes: { index: '03', label: 'Notes' },
    elsewhere: { index: '04', label: 'Elsewhere' },
  };

  const readoutIndex = document.querySelector<HTMLElement>('[data-readout-index]');
  const readoutLabel = document.querySelector<HTMLElement>('[data-readout-label]');
  const mobileReadoutIndex = document.querySelector<HTMLElement>('[data-mobile-readout-index]');
  const mobileReadoutLabel = document.querySelector<HTMLElement>('[data-mobile-readout-label]');
  const mobileMenu = document.querySelector<HTMLButtonElement>('[data-mobile-menu]');
  const railLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const dialogLinks = document.querySelectorAll<HTMLAnchorElement>('[data-index-link]');
  const dialog = document.querySelector<HTMLDialogElement>('#section-index');
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-index-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-index-close]');
  const toTopBtn = document.querySelector<HTMLAnchorElement>('[data-to-top]');

  let currentActiveId = 'top';

  // Section DOM elements
  const sectionEls = sections
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const setActiveSection = (id: string) => {
    if (!sectionMeta[id]) return;
    currentActiveId = id;

    // Toggle active section class for flight animations
    sectionEls.forEach((sec) => {
      const match = sec.id === id;
      if (match) {
        sec.classList.add('was-active');
      }
      sec.classList.toggle('is-section-active', match);
    });

    // Notify cat stage of section change
    window.dispatchEvent(new CustomEvent('section-changed', { detail: { id } }));

    if (readoutIndex) readoutIndex.textContent = sectionMeta[id].index;
    if (readoutLabel) readoutLabel.textContent = sectionMeta[id].label;
    if (mobileReadoutIndex) mobileReadoutIndex.textContent = sectionMeta[id].index;
    if (mobileReadoutLabel) mobileReadoutLabel.textContent = sectionMeta[id].label;
    if (mobileMenu) {
      mobileMenu.setAttribute('aria-label', `Open section menu. Current section: ${sectionMeta[id].label}`);
    }

    railLinks.forEach((link) => {
      const match = link.getAttribute('data-section-link') === id;
      link.classList.toggle('is-active', match);
      if (match) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    desktopLinks.forEach((link) => {
      const match = link.getAttribute('data-nav-link') === id;
      link.classList.toggle('is-active', match);
    });

    dialogLinks.forEach((link) => {
      const match = link.getAttribute('data-index-link') === id;
      link.classList.toggle('is-active', match);
    });
  };

  // IntersectionObserver for tracking active section and triggering transitions
  if ('IntersectionObserver' in window && sectionEls.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveSection(entry.target.id);
          }
        });
      },
      {
        rootMargin: '-10% 0px -10% 0px',
        threshold: 0.15,
      }
    );

    sectionEls.forEach((el) => observer.observe(el));
  }

  // Set initial active state based on hash or top
  const initialHash = window.location.hash.replace('#', '');
  if (initialHash && sectionMeta[initialHash]) {
    setActiveSection(initialHash);
  } else {
    setActiveSection('top');
  }

  // Dialog Controls
  let dialogTrigger: HTMLElement | null = null;

  const openDialog = (trigger?: HTMLElement) => {
    if (!dialog || dialog.open) return;
    dialogTrigger = trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    dialog.showModal();
    document.documentElement.classList.add('is-index-open');
    toggleBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'true'));
  };

  const closeDialog = () => {
    if (!dialog) return;
    dialog.close();
    document.documentElement.classList.remove('is-index-open');
    toggleBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
  };

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (dialog && dialog.open) {
        closeDialog();
      } else {
        openDialog(btn);
      }
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', closeDialog);
  }

  if (dialog) {
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('is-index-open');
      toggleBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
      // The native close path (Escape) and the button path both land here.
      dialogTrigger?.focus();
      dialogTrigger = null;
    });

    // Close when clicking dialog backdrop
    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;

      if (!isInDialog) {
        closeDialog();
      }
    });
  }

  // Close dialog when clicking any jump link
  dialogLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeDialog();
    });
  });

  // Global Keyboard Navigation:
  window.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const isInput =
      target &&
      (target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable);

    if (isInput) return;

    if (event.key === 'j' || event.key === 'J' || (event.key === '/' && !event.metaKey && !event.ctrlKey)) {
      if (dialog && !dialog.open) {
        event.preventDefault();
        openDialog();
      }
      return;
    }

    if (dialog && dialog.open) return;

    // Slide navigation with arrow keys on desktop
    if (window.innerWidth >= 960) {
      const currentIdx = sections.indexOf(currentActiveId);
      if (event.key === 'ArrowDown' || event.key === 'PageDown') {
        if (currentIdx >= 0 && currentIdx < sections.length - 1) {
          event.preventDefault();
          const nextTarget = document.getElementById(sections[currentIdx + 1]);
          nextTarget?.scrollIntoView({ behavior: 'smooth' });
        }
      } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        if (currentIdx > 0) {
          event.preventDefault();
          const prevTarget = document.getElementById(sections[currentIdx - 1]);
          prevTarget?.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }
  });

  // Floating to-top button visibility on scroll (Desktop)
  const handleScroll = () => {
    if (!toTopBtn) return;
    const scrolled = window.scrollY > 360;
    toTopBtn.classList.toggle('is-visible', scrolled);
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // The rail star travels from the first section to the last as the page scrolls.
  const rail = document.querySelector<HTMLElement>('.section-rail');
  let railFrame = 0;

  const paintRail = () => {
    railFrame = 0;
    if (!rail) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    rail.style.setProperty('--rail-progress', progress.toFixed(4));
  };

  const requestRail = () => {
    if (!railFrame) railFrame = requestAnimationFrame(paintRail);
  };

  window.addEventListener('scroll', requestRail, { passive: true });
  window.addEventListener('resize', requestRail, { passive: true });
  paintRail();

  if (toTopBtn) {
    toTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      history.pushState(null, '', '#top');
    });
  }
</script>
