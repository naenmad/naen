---
// Deterministic star field: the same sky on every build, generated once at build time
// so the page ships no runtime star logic and no hydration cost.
const seededRandom = (seed: number) => {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
};

const random = seededRandom(20261119);
const between = (min: number, max: number) => min + random() * (max - min);

const createStars = (
  prefix: string,
  count: number,
  size: [number, number],
  opacity: [number, number],
  twinkleRate: number,
) =>
  Array.from({ length: count }, (_, index) => ({
    id: `${prefix}-${index}`,
    x: Number(between(0.6, 99.4).toFixed(2)),
    y: Number(between(0.6, 99.4).toFixed(2)),
    size: Number(between(size[0], size[1]).toFixed(2)),
    opacity: Number(between(opacity[0], opacity[1]).toFixed(2)),
    twinkle: random() < twinkleRate,
    delay: Number(between(-19, 0).toFixed(2)),
    duration: Number(between(10, 21).toFixed(2)),
  }));

// Three planes, far to near: small and dim in the distance, sparse and brighter up close.
const farStars = createStars('far', 62, [1, 1.6], [0.18, 0.5], 0.08);
const midStars = createStars('mid', 43, [1.3, 2], [0.28, 0.68], 0.16);
const nearStars = createStars('near', 18, [1.8, 2.8], [0.5, 0.95], 0.45);

const dustMotes = Array.from({ length: 6 }, (_, index) => ({
  id: `mote-${index}`,
  x: Number(between(4, 96).toFixed(2)),
  y: Number(between(4, 96).toFixed(2)),
  size: Number(between(1.5, 3).toFixed(2)),
  delay: Number(between(-14, 0).toFixed(2)),
  duration: Number(between(16, 26).toFixed(2)),
}));

// Four named-feeling anchor stars. A uniform field cannot show parallax, because there is
// nothing to track; these are the landmarks the eye follows while the sky drifts.
const anchorStars = [
  { id: 'anchor-a', x: 21.5, y: 34, size: 2.6, opacity: 0.95, delay: -3, duration: 16 },
  { id: 'anchor-b', x: 63, y: 30, size: 3, opacity: 1, delay: -9, duration: 19 },
  { id: 'anchor-c', x: 76.5, y: 62, size: 2.4, opacity: 0.9, delay: -6, duration: 14 },
  { id: 'anchor-d', x: 9, y: 55, size: 2.2, opacity: 0.85, delay: -12, duration: 21 },
];

// The band is not a texture: it is unresolved star grain packed along one diagonal,
// which is what makes a galaxy read as a galaxy instead of as fog.
const BAND_ORIGIN = { x: 4, y: 91 };
const BAND_SLOPE = -0.848;
const bandStars = Array.from({ length: 310 }, (_, index) => {
  const x = between(3, 97);
  // Distance from the core falls off sharply, so the grain gathers in the middle of the band.
  const pull = Math.pow(random(), 1.8);
  const side = random() < 0.5 ? -1 : 1;
  const y = BAND_ORIGIN.y + BAND_SLOPE * (x - BAND_ORIGIN.x) + side * pull * 8;
  return {
    id: `band-${index}`,
    x: Number(Math.min(98, Math.max(2, x)).toFixed(2)),
    y: Number(Math.min(98, Math.max(2, y)).toFixed(2)),
    size: Number(between(0.8, 1.9).toFixed(2)),
    opacity: Number((between(0.16, 0.62) * (1 - pull * 0.5)).toFixed(2)),
    twinkle: random() < 0.08,
    delay: Number(between(-18, 0).toFixed(2)),
    duration: Number(between(12, 21).toFixed(2)),
  };
});
---

<div class="cosmic-scene" aria-hidden="true">
  <div class="sky-layer sky-layer--nebula" data-rate="12" data-touch="static">
    <div class="sky-plate sky-plate--nebula"></div>
  </div>

  <div class="sky-layer sky-layer--band" data-rate="26" data-touch="static">
    <div class="sky-plate sky-plate--band"></div>
    {bandStars.map((star) => (
      <span
        class:list={['star', { 'star--twinkle': star.twinkle }]}
        style={`left:${star.x}%;top:${star.y}%;--s:${star.size};--o:${star.opacity};--delay:${star.delay}s;--duration:${star.duration}s`}
      ></span>
    ))}
  </div>

  <div class="sky-layer sky-layer--dust" data-rate="62">
    {dustMotes.map((mote) => (
      <span
        class="dust-mote"
        style={`left:${mote.x}%;top:${mote.y}%;--s:${mote.size};--delay:${mote.delay}s;--duration:${mote.duration}s`}
      ></span>
    ))}
  </div>

  <div class="sky-layer sky-layer--stars" data-rate="90">
    {farStars.map((star) => (
      <span
        class:list={['star', { 'star--twinkle': star.twinkle }]}
        style={`left:${star.x}%;top:${star.y}%;--s:${star.size};--o:${star.opacity};--delay:${star.delay}s;--duration:${star.duration}s`}
      ></span>
    ))}
  </div>

  <div class="sky-layer sky-layer--stars" data-rate="110">
    {midStars.map((star) => (
      <span
        class:list={['star', 'star--mid', { 'star--twinkle': star.twinkle }]}
        style={`left:${star.x}%;top:${star.y}%;--s:${star.size};--o:${star.opacity};--delay:${star.delay}s;--duration:${star.duration}s`}
      ></span>
    ))}
  </div>

  <div class="sky-layer sky-layer--stars" data-rate="130">
    {nearStars.map((star) => (
      <span
        class:list={['star', 'star--near', { 'star--twinkle': star.twinkle }]}
        style={`left:${star.x}%;top:${star.y}%;--s:${star.size};--o:${star.opacity};--delay:${star.delay}s;--duration:${star.duration}s`}
      ></span>
    ))}
    {anchorStars.map((star) => (
      <span
        class="star star--near star--anchor star--twinkle"
        style={`left:${star.x}%;top:${star.y}%;--s:${star.size};--o:${star.opacity};--delay:${star.delay}s;--duration:${star.duration}s`}
      ></span>
    ))}
  </div>

  <!-- The page ends near dawn. The arc stays dark until the last sections. -->
  <div class="dawn" data-dawn>
    <svg class="dawn__arc" viewBox="0 0 1000 120" preserveAspectRatio="none" focusable="false">
      <path d="M 0 118 Q 500 2 1000 118" />
    </svg>
  </div>

  <span class="meteor" data-rate="0"></span>
  <span class="meteor meteor--second" data-rate="0"></span>
  <span class="wish" data-wish></span>
  <div class="sky-vignette"></div>
</div>
