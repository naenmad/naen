---
interface Props {
  direction?: 'up-right' | 'right' | 'up';
  class?: string;
}

const { direction = 'up-right', class: className = '' } = Astro.props;

const paths = {
  'up-right': 'M5 11 L11 5 M6.4 5 H11 V9.6',
  right: 'M3 8 H13 M9 4 L13 8 L9 12',
  up: 'M8 13 V3 M4 7 L8 3 L12 7',
};
---

<svg class:list={['icon-arrow', className]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path
    d={paths[direction]}
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
